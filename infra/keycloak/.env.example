POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=cambia_esto
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=cambia_esto

# Realm lab (import/lab-realm.json): se leen solo en la primera importación.
# Usa valores propios y distintos; los de ejemplo no sirven como secretos.
# Secret del client chat-api (el mismo valor lo usas al pedir un token).
KC_CHAT_API_SECRET=cambia_esto
# Secret del client finanzas-agent; el mismo valor va en agents/orquestador/.env
# como FINANZAS_AGENT_CLIENT_SECRET.
FINANZAS_AGENT_CLIENT_SECRET=cambia_esto
# Contraseñas de los usuarios de prueba ana, beto y admin (realm lab).
KC_ANA_PASSWORD=cambia_esto
KC_BETO_PASSWORD=cambia_esto
KC_LAB_ADMIN_PASSWORD=cambia_esto
