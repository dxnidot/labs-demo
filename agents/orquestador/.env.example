# ==============================================================================
# ORQUESTADOR & AGENTS CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider & Routing
# ------------------------------------------------------------------------------
# Claves de acceso a proveedores LLM
GEMINI_API_KEY=AIzaSy_tu_gemini_api_key_aqui
DEEPSEEK_API_KEY=sk-tu_deepseek_api_key_aqui

# ------------------------------------------------------------------------------
# 2. SSL & Local Development Bypass
# ------------------------------------------------------------------------------
# Desactiva la verificación estricta de certificados en LiteLLM / aiohttp
# Útil en redes corporativas o VPNs con inspección TLS/SSL
SSL_VERIFY=False
PYTHONHTTPSVERIFY=0

# ------------------------------------------------------------------------------
# 3. Keycloak / IAM Configuration (OAuth2 / OIDC)
# ------------------------------------------------------------------------------
# Realm: lab
KEYCLOAK_BASE_URL=http://localhost:8080
# Leidas por orquestador/api.py para verificar el Bearer JWT (issuer + audience
# del access token). Sin estas dos, todo endpoint devuelve 503.
KEYCLOAK_ISSUER=http://localhost:8080/realms/lab
KEYCLOAK_AUDIENCE=agents-ui
FINANZAS_AGENT_CLIENT_ID=finanzas-agent
FINANZAS_AGENT_CLIENT_SECRET=tu_client_secret_generado_en_keycloak
FINANZAS_AGENT_TOKEN_URL=http://localhost:8080/realms/lab/protocol/openid-connect/token

# ------------------------------------------------------------------------------
# 4. Backend Microservices Integration
# ------------------------------------------------------------------------------
# API Spring Boot de Finanzas (kc-demo)
FINANZAS_API_URL=http://127.0.0.1:8081

# ------------------------------------------------------------------------------
# 5. ADK Server Settings
# ------------------------------------------------------------------------------
ADK_PORT=8010
CORS_ALLOWED_ORIGINS=http://localhost:5173