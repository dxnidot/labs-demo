# ==============================================================================
# ORQUESTADOR & AGENTS CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider & Routing
# ------------------------------------------------------------------------------
# Claves de acceso a proveedores LLM
GEMINI_API_KEY=AIzaSy_tu_gemini_api_key_aqui
DEEPSEEK_API_KEY=sk-tu_deepseek_api_key_aqui

# ------------------------------------------------------------------------------
# 2. Verificación TLS (dejar ACTIVADA)
# ------------------------------------------------------------------------------
# ADVERTENCIA: las dos variables siguientes, si se activan, DESACTIVAN la
# verificación de certificados TLS en las llamadas a los proveedores de LLM
# (LiteLLM / aiohttp). Con ellas, cualquiera que esté en la red puede suplantar
# al proveedor o interceptar la conexión y ver tus mensajes, los datos que las
# herramientas devuelven al modelo y tus API keys.
# No las descomentes. Si una red corporativa o VPN inspecciona TLS, instala el
# certificado raíz de esa red en el sistema en lugar de desactivar la verificación.
# SSL_VERIFY=False
# PYTHONHTTPSVERIFY=0

# ------------------------------------------------------------------------------
# 3. Keycloak / IAM Configuration (OAuth2 / OIDC)
# ------------------------------------------------------------------------------
# Realm: lab
KEYCLOAK_BASE_URL=http://localhost:8080
# Leidas por orquestador/api.py para verificar el Bearer JWT (issuer + audience
# del access token). Sin estas dos, todo endpoint devuelve 503.
KEYCLOAK_ISSUER=http://localhost:8080/realms/lab
KEYCLOAK_AUDIENCE=lara-web
FINANZAS_AGENT_CLIENT_ID=finanzas-agent
FINANZAS_AGENT_CLIENT_SECRET=tu_client_secret_generado_en_keycloak
FINANZAS_AGENT_TOKEN_URL=http://localhost:8080/realms/lab/protocol/openid-connect/token

# ------------------------------------------------------------------------------
# 4. Backend Microservices Integration
# ------------------------------------------------------------------------------
# API Spring Boot de Finanzas (kc-finanzas)
FINANZAS_API_URL=http://127.0.0.1:8083

# ------------------------------------------------------------------------------
# 5. ADK Server Settings
# ------------------------------------------------------------------------------
ADK_PORT=8010
CORS_ALLOWED_ORIGINS=http://localhost:5173